{
  "ssh_connections": [
    {
      "host": "nixos-server",
      "username": "totto2727",
      "args": ["-A"],
      "projects": [
        {
          "paths": ["/home/totto2727/.local/share/chezmoi/./"]
        },
        {
          "paths": ["/home/totto2727/proj/nix"]
        }
      ]
    }
  ],
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    }
  },
  "agent": {
    "single_file_review": true,
    "tool_permissions": {
      "tools": {
        "terminal": {
          "always_allow": [
            {
              "pattern": "^cat\\b"
            },
            {
              "pattern": "^ls\\b"
            }
          ]
        }
      }
    },
    "inline_assistant_model": {
      "provider": "Z",
      "model": "GLM-5.1",
      "enable_thinking": false
    },
    "favorite_models": [
      {
        "provider": "Z",
        "model": "GLM-5.1"
      },
      {
        "provider": "Z",
        "model": "GLM-5-Turbo"
      },
      {
        "provider": "Z",
        "model": "GLM-5"
      },
      {
        "provider": "Z",
        "model": "GLM-4.7"
      },
      {
        "provider": "Z",
        "model": "GLM-4.7-FlashX"
      },
      {
        "provider": "Z",
        "model": "GLM-4.7-Flash"
      }
    ],
    "default_model": {
      "provider": "Z",
      "model": "GLM-5.1"
    },
    "model_parameters": [],
    "play_sound_when_agent_done": true,
    "use_modifier_to_send": true
  },
  "base_keymap": "Cursor",
  "buffer_font_family": "PlemolJP35",
  "buffer_font_size": 15,
  "collaboration_panel": {
    "dock": "right"
  },
  "edit_predictions": {
    "provider": "copilot"
  },
  "format_on_save": "on",
  "git": {
    "hunk_style": "staged_hollow",
    "inline_blame": {
      "enabled": true,
      "show_commit_summary": true
    },
    "path_style": "file_path_first"
  },
  "git_panel": {
    "collapse_untracked_diff": false,
    "dock": "right",
    "sort_by_path": true,
    "status_style": "icon",
    "tree_view": true
  },
  "icon_theme": "Zed (Default)",
  "language_servers": ["!typescript-language-server", "!biome", "!dprint", "!prettier", "..."],
  "languages": {
    "JSON": {
      "code_actions_on_format": {
        "source.fixAll.oxc": true,
        "source.organizeImports.oxc": true
      },
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      }
    },
    "JSONC": {
      "code_actions_on_format": {
        "source.fixAll.oxc": true,
        "source.organizeImports.oxc": true
      },
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      }
    },
    "JavaScript": {
      "code_actions_on_format": {
        "source.fixAll.oxc": true,
        "source.organizeImports.oxc": true
      },
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      }
    },
    "TSX": {
      "code_actions_on_format": {
        "source.fixAll.oxc": true,
        "source.organizeImports.oxc": true
      },
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      }
    },
    "TypeScript": {
      "code_actions_on_format": {
        "source.fixAll.oxc": true,
        "source.organizeImports.oxc": true
      },
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      }
    }
  },
  "lsp": {
    "oxfmt": {
      "initialization_options": {
        "settings": {
          "fmt.configPath": null,
          "run": "onSave"
        }
      }
    },
    "oxlint": {
      "initialization_options": {
        "settings": {
          "fixKind": "dangerous_fix_or_suggestion",
          "run": "onType",
          "typeAware": true,
          "unusedDisableDirectives": "deny"
        }
      }
    },
    "vtsls": {
      "enable_lsp_tasks": true,
      "settings": {
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        },
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        }
      }
    }
  },
  "theme": {
    "dark": "Ayu Dark",
    "light": "Ayu Light",
    "mode": "dark"
  },
  "ui_font_family": "PlemolJP35",
  "ui_font_size": 15,
  "vim_mode": true,
  "language_models": {
    "openai_compatible": {
      "Z": {
        "api_url": "https://api.z.ai/api/coding/paas/v4",
        "available_models": [
          {
