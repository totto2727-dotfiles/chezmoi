{
  "agent": {
    "default_model": {
      "model": "claude-haiku-4-5",
      "provider": "zed.dev"
    },
    "favorite_models": [
      {
        "model": "claude-haiku-4-5",
        "provider": "zed.dev"
      },
      {
        "model": "claude-haiku-4-5-latest",
        "provider": "anthropic"
      },
      {
        "model": "claude-haiku-4-5-thinking-latest",
        "provider": "anthropic"
      },
      {
        "model": "claude-sonnet-4-5",
        "provider": "zed.dev"
      },
      {
        "model": "claude-sonnet-4-5-thinking",
        "provider": "zed.dev"
      },
      {
        "model": "claude-opus-4-6-thinking-latest",
        "provider": "anthropic"
      },
      {
        "model": "claude-opus-4-6-1m-context-latest",
        "provider": "anthropic"
      },
      {
        "model": "claude-opus-4-6-1m-context-thinking-latest",
        "provider": "anthropic"
      }
    ],
    "model_parameters": [],
    "play_sound_when_agent_done": true,
    "use_modifier_to_send": true
  },
  "base_keymap": "Cursor",
  "buffer_font_family": "PlemolJP35",
  "buffer_font_size": 15,
  "collaboration_panel": {
    "dock": "right"
  },
  "edit_predictions": {
    "provider": "sweep"
  },
  "format_on_save": "on",
  "git": {
    "hunk_style": "staged_hollow",
    "inline_blame": {
      "enabled": true,
      "show_commit_summary": true
    },
    "path_style": "file_path_first"
  },
  "git_panel": {
    "collapse_untracked_diff": false,
    "dock": "right",
    "sort_by_path": true,
    "status_style": "icon",
    "tree_view": true
  },
  "icon_theme": "Zed (Default)",
  "language_servers": ["!typescript-language-server", "!biome", "!dprint", "!prettier", "..."],
  "languages": {
    "JSON": {
      "code_actions_on_format": {
        "source.fixAll.oxc": true,
        "source.organizeImports.oxc": true
      },
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      }
    },
    "JSONC": {
      "code_actions_on_format": {
        "source.fixAll.oxc": true,
        "source.organizeImports.oxc": true
      },
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      }
    },
    "JavaScript": {
      "code_actions_on_format": {
        "source.fixAll.oxc": true,
        "source.organizeImports.oxc": true
      },
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      }
    },
    "TSX": {
      "code_actions_on_format": {
        "source.fixAll.oxc": true,
        "source.organizeImports.oxc": true
      },
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      }
    },
    "TypeScript": {
      "code_actions_on_format": {
        "source.fixAll.oxc": true,
        "source.organizeImports.oxc": true
      },
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      }
    }
  },
  "lsp": {
    "oxfmt": {
      "initialization_options": {
        "settings": {
          "fmt.configPath": null,
          "run": "onSave"
        }
      }
    },
    "oxlint": {
      "initialization_options": {
        "settings": {
          "fixKind": "dangerous_fix_or_suggestion",
          "run": "onType",
          "typeAware": true,
          "unusedDisableDirectives": "deny"
        }
      }
    },
    "vtsls": {
      "enable_lsp_tasks": true,
      "settings": {
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        },
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        }
      }
    }
  },
  "theme": {
    "dark": "Ayu Dark",
    "light": "Ayu Light",
    "mode": "dark"
  },
  "ui_font_family": "PlemolJP35",
  "ui_font_size": 15,
  "vim_mode": true
}
