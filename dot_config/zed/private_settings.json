  "collaboration_panel": {
    "dock": "right"
  },
  "// custom settings, run `zed: open default settings` from the command palette (cmd-shift-p / ctrl-shift-p)": "",
  "base_keymap": "Cursor",
  "buffer_font_family": "PlemolJP35",
  "buffer_font_size": 15,
  "git": {
    "hunk_style": "staged_hollow",
    "inline_blame": {
      "enabled": true,
      "show_commit_summary": true
    },
    "path_style": "file_path_first"
  },
  "git_panel": {
    "collapse_untracked_diff": false,
    "dock": "right",
    "sort_by_path": true,
    "status_style": "icon",
    "tree_view": true
  },
  "icon_theme": "Zed (Default)",
  "lsp": {
    "biome": {
      "settings": {
        "require_config_file": true
      }
    }
  },
  "theme": {
    "dark": "Ayu Dark",
    "light": "Ayu Light",
    "mode": "dark"
  },
  "ui_font_family": "PlemolJP35",
  "ui_font_size": 15,
  "vim_mode": true
