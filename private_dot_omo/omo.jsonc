// OMO configuration
{
  "[opencode]": {
    "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
    "agents": {
      "sisyphus": {
        "model": "openai/gpt-5.6-sol",
        "variant": "medium"
      },
      "hephaestus": {
        "model": "openai/gpt-5.6-sol",
        "variant": "medium"
      },
      "oracle": {
        "model": "openai/gpt-5.6-sol",
        "variant": "xhigh"
      },
      "librarian": {
        "model": "openai/gpt-5.6-luna-fast",
        "variant": "low"
      },
      "explore": {
        "model": "openai/gpt-5.6-luna-fast",
        "variant": "low"
      },
      "multimodal-looker": {
        "model": "openai/gpt-5.6-sol",
        "variant": "low",
        "fallback_models": [
          {
            "model": "openai/gpt-5-nano"
          }
        ]
      },
      "prometheus": {
        "model": "opencode/gpt-5-nano"
      },
      "metis": {
        "model": "opencode/gpt-5-nano"
      },
      "momus": {
        "model": "openai/gpt-5.6-terra",
        "variant": "high",
        "fallback_models": [
          {
            "model": "openai/gpt-5.6-sol",
            "variant": "xhigh"
          }
        ]
      },
      "atlas": {
        "model": "openai/gpt-5.6-sol",
        "variant": "medium"
      },
      "sisyphus-junior": {
        "model": "openai/gpt-5.6-sol",
        "variant": "medium"
      }
    },
    "categories": {
      "visual-engineering": {
        "model": "openai/gpt-5.6-sol",
        "variant": "high"
      },
      "ultrabrain": {
        "model": "openai/gpt-5.6-sol",
        "variant": "xhigh"
      },
      "deep": {
        "model": "openai/gpt-5.6-sol",
        "variant": "medium"
      },
      "artistry": {
        "model": "openai/gpt-5.6-sol",
        "variant": "xhigh"
      },
      "quick": {
        "model": "openai/gpt-5.6-luna-fast"
      },
      "unspecified-low": {
        "model": "openai/gpt-5.6-terra",
        "variant": "high"
      },
      "unspecified-high": {
        "model": "openai/gpt-5.6-terra",
        "variant": "high"
      },
      "writing": {
        "model": "openai/gpt-5.6-sol",
        "variant": "medium"
      }
    }
  }
}
