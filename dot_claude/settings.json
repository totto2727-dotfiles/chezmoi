{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "editorMode": "normal",
  "effortLevel": "medium",
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "env": {
    "ANTHROPIC_MODEL": "claude-opus-5",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "'/Users/hayato.tsuchida/.local/bin/jcode' setup-hotkey --notify-cli-launch claude",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "startup|resume"
      }
    ]
  },
  "language": "japanese",
  "permissions": {
    "additionalDirectories": [],
    "allow": [
      "Read(/**)",
      "Read(~/.agents/**)",
      "Read(~/.claude/CLAUDE.md)",
      "Read(~/.claude/settings.json)",
      "Read(~/.claude/skills/**)",
      "Read(~/.claude/plugins/marketplaces/**)",
      "Edit(/.claude/CLAUDE.md)",
      "Edit(/.claude/skills/**)",
      "Edit(~/.claude/CLAUDE.md)",
      "Edit(~/.claude/skills/**)",
      "Edit(//tmp/**)",
      "Bash(git commit *)",
      "Bash(git stash push *)",
      "Bash(git stash apply *)",
      "Bash(git switch *)",
      "Bash(git restore *)",
      "Bash(ctx7 library:*)",
      "Bash(ctx7 docs:*)",
      "WebFetch(domain:npm.flatt.tech)",
      "WebFetch(domain:jsr.io)",
      "WebFetch(domain:www.components.build)",
      "WebFetch(domain:components.build)",
      "WebFetch(domain:docs.moonbitlang.com)",
      "WebFetch(domain:www.moonbitlang.com)",
      "WebFetch(domain:raw.githubusercontent.com)"
    ],
    "ask": ["Bash(gh pr create *)", "Bash(git push *)"],
    "defaultMode": "auto",
    "deny": ["Bash(git commit --no-verify *)", "Bash(git commit --no-gpg-sign *)"],
    "disableBypassPermissionsMode": "disable"
  },
  "sandbox": {
    "allowUnsandboxedCommands": true,
    "enabled": true,
    "excludedCommands": ["ctx7:*", "git commit:*", "gh:*"]
  },
  "skipAutoPermissionPrompt": true,
  "theme": "dark",
  "tui": "fullscreen",
  "outputStyle": "Concise"
}
