{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "language": "japanese",
  "sandbox": {
    "enabled": true,
    "excludedCommands": ["git", "gh"]
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "fileSuggestion": {
    "type": "command",
    "command": "~/.claude/file-suggestion.sh"
  },
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Read(~/.zshrc)",
      "Bash(echo *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(sed *)",
      "Bash(find *)",
      "Bash(ls *)",
      "Bash(ls *)",
      "Bash(which *)",
      "Bash(whoami)",
      "Bash(pwd)",
      "Bash(echo *)",
      "Bash(cat *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(jq *)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(diff *)",
      "Bash(tar *)",
      "Bash(zip *)",
      "Bash(unzip *)",
      "Bash(bat *)",
      "Bash(rg *)",
      "Bash(sd *)",
      "Bash(fd *)",
      "Bash(delta *)",
      "Bash(git delta *)",
      "Bash(git unstage)",
      "Bash(git undo)",
      "Bash(git stash push *)",
      "Bash(git stash apply *)",
      "Bash(git add *)",
      "Bash(git rm *)",
      "Bash(git log *)",
      "Bash(git status *)",
      "Bash(git switch *)",
      "Bash(git diff *)",
      "Bash(git branch *)",
      "Bash(git cherry-pick *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git tag *)",
      "Bash(git show *)",
      "Bash(git blame *)",
      "Bash(git rev-parse *)",
      "Bash(git commit *)",
      "Bash(devbox shell)",
      "Bash(task check)",
      "Bash(task fix)",
      "Bash(task test)",
      "Bash(task build)",
      "Bash(pnpm run check)",
      "Bash(pnpm run fix)",
      "Bash(pnpm run build)",
      "Bash(pnpm run test)",
      "Bash(pnpm dlx vitest)",
      "Bash(pnpm dlx vitest ./*)",
      "Bash(pnpm dlx biome *)",
      "Bash(pnpm dlx dprint *)",
      "Bash(pnpm dlx oxlint *)",
      "Bash(pnpm dlx oxc *)",
      "Bash(pnpm dlx ultracite *)",
      "Bash(pnpm dlx tsgo *)",
      "Bash(bun run check)",
      "Bash(bun run fix)",
      "Bash(bun run build)",
      "Bash(bun run test)",
      "Bash(bun test)",
      "Bash(bun test ./*)",
      "Bash(bunx vitest)",
      "Bash(bunx vitest ./*)",
      "Bash(bunx biome *)",
      "Bash(bunx dprint *)",
      "Bash(bunx oxlint *)",
      "Bash(bunx oxc *)",
      "Bash(bunx ultracite *)",
      "Bash(bunx tsgo *)",
      "Bash(safe-chain *)"
    ],
    "ask": ["Bash(gh pr create *)", "Bash(git push *)"],
    "deny": [
      "Read(*.local)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./config/credentials.json)",
      "Read(./build)",
      "Bash(sudo)",
      "Bash(sudo *)",
      "Bash(rm *)",
      "Bash(unlink *)",
      "Bash(mv *)",
      "Bash(git reset *)",
      "Bash(git stash clear *)",
      "Bash(git stash pop *)",
      "Bash(deno run -A *)",
      "Bash(deno run --allow-all *)",
      "Bash(brew *)",
      "Bash(chmod 777 *)",
      "Bash(chmod -R 777 *)",
      "Bash(mkfs *)",
      "Bash(dd *)",
      "Bash(kill -9 *)",
      "Bash(killall *)",
      "Bash(shutdown *)",
      "Bash(reboot *)",
      "Bash(curl * | bash)",
      "Bash(curl * | sh)",
      "Bash(wget * | bash)",
      "Bash(wget * | sh)",
      "Bash(eval *)",
      "Bash(exec *)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git clean *)",
      "Bash(rmdir *)",
      "Bash(docker *)",
      "Bash(podman *)",
      "Bash(incus *)",
      "Bash(lima *)",
      "Bash(* deploy)",
      "Bash(* publish)",
      "Bash(cat .env*)",
      "Bash(cat */.env*)",
      "Bash(cat */secrets/*)",
      "Bash(grep * .env*)",
      "Bash(grep * */.env*)",
      "Bash(rg * .env*)",
      "Bash(rg * */.env*)",
      "Bash(sed -i *)",
      "Bash(sd * * *)",
      "Bash(echo * > *)",
      "Bash(echo * >> *)",
      "Bash(cat > *)",
      "Bash(cat >> *)",
      "Bash(bash *)",
      "Bash(sh *)",
      "Bash(zsh *)"
    ]
  }
}
