{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Read(/**)",
      "Read(~/.agents/**)",
      "Read(~/.claude/CLAUDE.md)",
      "Read(~/.claude/settings.json)",
      "Read(~/.claude/skills/**)",
      "Read(~/.claude/plugins/marketplaces/**)",
      "Bash(git commit *)",
      "Bash(git stash push *)",
      "Bash(git stash apply *)",
      "Bash(git switch *)",
      "Bash(git restore *)",
      "Bash(ctx7 library:*)",
      "Bash(ctx7 docs:*)",
      "WebFetch(domain:npm.flatt.tech)",
      "WebFetch(domain:jsr.io)",
      "WebFetch(domain:www.components.build)",
      "WebFetch(domain:components.build)",
      "WebFetch(domain:docs.moonbitlang.com)",
      "WebFetch(domain:www.moonbitlang.com)",
      "WebFetch(domain:raw.githubusercontent.com)"
    ],
    "deny": [
      "Bash(git commit --no-verify *)",
      "Bash(git commit --no-gpg-sign *)",
      "Bash(git reset *)",
      "Bash(git checkout *)",
      "Bash(git stash pop *)",
      "Bash(git stash clear *)",
      "Bash(git stash drop *)"
    ],
    "ask": ["Bash(gh pr create *)", "Bash(git push *)"],
    "defaultMode": "auto"
  },
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true
  },
  "language": "japanese",
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": true,
    "excludedCommands": ["ctx7:*", "git commit:*", "gh:*"]
  },
  "skipAutoPermissionPrompt": true,
  "editorMode": "vim"
}
